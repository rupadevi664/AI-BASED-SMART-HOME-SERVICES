# ==============================================================================
# Production Environment Configuration Template
# Copy this file to .env.production on your production server:
#   cp .env.production.example .env.production
# ==============================================================================

# --- Domain & Networking ---
# Public domain or server IP (e.g. https://smarthome.example.com or http://203.0.113.10)
DOMAIN=https://yourdomain.com
HTTP_PORT=80

# --- Database (MySQL 8.0) ---
MYSQL_ROOT_PASSWORD=replace_with_strong_root_password_32_chars
MYSQL_DATABASE=ai_home_services
MYSQL_USER=home_user
MYSQL_PASSWORD=replace_with_strong_db_password_32_chars

# --- Security & JWT Authentication ---
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=replace_with_generated_random_64_hex_secret_key
ACCESS_TOKEN_EXPIRE_MINUTES=120

# --- Initial Platform Administrator Account ---
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=replace_with_secure_admin_password_16_chars

# --- CORS Allowed Origins ---
# Comma-separated list of public origins allowed to call the backend API
CORS_ORIGINS=https://yourdomain.com,http://yourdomain.com,https://www.yourdomain.com

# --- Frontend Build Target URLs ---
# Leave blank to automatically use current origin and ws/wss protocol
VITE_API_BASE_URL=
VITE_WS_BASE_URL=

# --- Phase 6: Razorpay Live / Test Payments ---
# Leave empty if payments are not needed yet (endpoints return 503)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_CURRENCY=INR

# --- Phase 7 & 8: Google Gemini AI Diagnostics & RAG ---
# Get key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Concurrency & Performance ---
WEB_CONCURRENCY=4
