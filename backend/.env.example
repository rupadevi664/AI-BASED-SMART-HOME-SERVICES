# ---- Database -----------------------------------------------------------
# MySQL example (recommended). URL-encode special characters in the password,
# e.g. @ -> %40
DATABASE_URL=mysql+pymysql://root:rupadevi@localhost:3306/ai_home_services

# ---- JWT ----------------------------------------------------------------
JWT_SECRET_KEY=CHANGE_THIS_SECRET_USE_AT_LEAST_32_RANDOM_CHARACTERS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ---- Optional: seed an initial ADMIN account with `python -m app.init_db --admin`
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_THIS_ADMIN_PASSWORD
ADMIN_NAME=Platform Admin

# ---- Phase 5: live location tracking ------------------------------------
# Minimum seconds between accepted location updates per booking (throttle).
LOCATION_UPDATE_INTERVAL_SECONDS=1
# Retention window (days) for live_locations rows. Cleanup is an explicit,
# opt-in maintenance action (app.services.location_service.purge_expired_locations)
# — nothing is ever deleted automatically.
LOCATION_HISTORY_RETENTION_DAYS=7

# ---- CORS (React frontend) ----------------------------------------------
# Comma-separated allowed origins for the frontend dev server / deployment.
# Defaults to the Vite dev server. Never use "*" in production.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Phase 6: Razorpay payments -----------------------------------------
# Get TEST MODE keys: Razorpay Dashboard → Settings → API Keys → Generate Key.
# RAZORPAY_KEY_ID is public (sent to the React frontend for Checkout).
# RAZORPAY_KEY_SECRET must NEVER leave the backend — it verifies signatures.
# Leave both empty to run the app without payments (endpoints return 503).
RAZORPAY_KEY_ID=rzp_test_TiDKia2KzmYdnZ
RAZORPAY_KEY_SECRET=hw2Xo570Pvse1eRZqjENjeBG
RAZORPAY_CURRENCY=INR

# ---- Phase 7: Google Gemini (AI assistant) ----
# Get a free API key: https://aistudio.google.com/apikey
# The key must stay on the backend — NEVER put it in the React frontend.
# Leave GEMINI_API_KEY empty to run without the assistant
# (POST /llm/chat responds 503 LLM_NOT_CONFIGURED).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT_SECONDS=20
GEMINI_MAX_HISTORY_TURNS=8
